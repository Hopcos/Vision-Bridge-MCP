# ===========================================================================
# 视觉后端选择
# ===========================================================================

# 视觉后端类型：
#   third_party - 第三方云端视觉模型（默认，提供 Endpoint + API Key 即可，
#                 无需本地部署多模态模型）
#   local_api   - 本地多模态模型（通过 OpenAI 兼容 API 调用）
#   paddleocr   - 纯 OCR，不需要多模态模型
#   tesseract   - 轻量 OCR（需系统安装 tesseract）
#   custom_api  - 任意返回图片描述的 HTTP API
#   auto        - 自动检测可用后端，按 third_party -> local_api -> paddleocr
#                 -> tesseract -> custom_api 顺序降级
VISION_BACKEND=third_party

# ---------------------------------------------------------------------------
# Backend 0/默认: third_party — 第三方云端视觉模型
# 只需第三方服务器暴露的 Endpoint + API Key，通过 OpenAI 兼容的
# /v1/chat/completions 接口调用（携带 Authorization: Bearer <key>）
# 示例：
#   阿里云百炼 DashScope:  https://dashscope.aliyuncs.com/compatible-mode/v1  (如 qwen-vl-max)
#   智谱 GLM-4V:          https://open.bigmodel.cn/api/paas/v4                (如 glm-4v)
#   OpenAI 兼容网关/聚合:  按服务商文档填写
# ---------------------------------------------------------------------------
# VISION_BACKEND=third_party
VISION_THIRD_PARTY_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_THIRD_PARTY_API_KEY=sk-xxxx
VISION_THIRD_PARTY_MODEL_NAME=qwen-vl-max

# ---------------------------------------------------------------------------
# Backend 1: local_api — 本地多模态模型（Qwen2-VL / MiniCPM-V / InternVL / LLaVA 等）
# 通过 OpenAI 兼容的 /v1/chat/completions 接口调用
# ---------------------------------------------------------------------------
# VISION_BACKEND=local_api
VISION_API_BASE=http://localhost:8001/v1
VISION_API_KEY=any
VISION_MODEL_NAME=Qwen2-VL-7B
VISION_MAX_TOKENS=4096
VISION_TIMEOUT=60

# ---------------------------------------------------------------------------
# Backend 2: paddleocr — 纯 OCR，无需部署多模态模型
# ---------------------------------------------------------------------------
# VISION_BACKEND=paddleocr
VISION_OCR_LANG=ch           # ch（中英混合）| en | japan | korean 等
VISION_OCR_USE_GPU=false

# ---------------------------------------------------------------------------
# Backend 3: tesseract — 轻量 OCR（需系统安装 tesseract 并配置语言包）
# ---------------------------------------------------------------------------
# VISION_BACKEND=tesseract
VISION_TESSERACT_LANG=chi_sim+eng
VISION_TESSERACT_CMD=tesseract

# ---------------------------------------------------------------------------
# Backend 4: custom_api — 任意返回图片描述的 HTTP API
# 请求体格式为 multipart/form-data，文件字段名 image，prompt 字段名 prompt
# ---------------------------------------------------------------------------
# VISION_BACKEND=custom_api
VISION_CUSTOM_API_URL=http://localhost:9000/describe
VISION_CUSTOM_API_METHOD=POST
VISION_CUSTOM_API_TIMEOUT=30

# ---------------------------------------------------------------------------
# 图片处理与并发限制
# ---------------------------------------------------------------------------
VISION_MAX_IMAGE_SIZE=20971520    # 原始图片最大字节数（20MB）
VISION_MAX_CONCURRENT=3           # 视觉模型最大并发调用数（防止本地模型过载）
# 发送给视觉模型前的压缩目标（KB）。>0 时迭代降低 JPEG 质量 / 尺寸直到输出不超过该字节数；
# 0 表示不按字节数压缩（仅按 max_width/max_height 缩放）。如压缩到 30KB：填 30
VISION_COMPRESS_TARGET_KB=0
# 压缩迭代时的最低 JPEG 质量（1-95），低于此值则改用进一步缩小尺寸
VISION_COMPRESS_MIN_QUALITY=40

# ---------------------------------------------------------------------------
# HTTP 图片下载授权（用于 Atlassian / Jira / Confluence 等需鉴权的图片）
# ---------------------------------------------------------------------------
# 当 describe_image 的 image_source 为需要授权的远程图片 URL 时：
# - 普通公网图：无需任何配置；直接下载。
# - Atlassian / Jira / Confluence 附件图（页面 URL / /wiki/download、jira:attachment:xxx 等）：
#   Atlassian 网页版下载 URL 不接受 Bearer，必须用 Basic 认证走 REST API。
#   因此需要 VISION_ATLASSIAN_USER（你的 Atlassian 登录邮箱）+ 下面的 token。
#   页面 URL（如 /wiki/spaces/PE/pages/<pageId>/<title>）会自动解析页面正文里的
#   <ac:image> 引用，取页面实际展示的图片。
# 支持两种 token：
#   - Bearer 写法（PAT）：VISION_HTTP_DOWNLOAD_TOKEN=ATATT3xFfGF0... TYPE=bearer
#   - Basic 写法（邮箱:API Token/PAT）：VISION_HTTP_DOWNLOAD_TOKEN=your-token TYPE=basic
#     （配合 VISION_ATLASSIAN_USER=你的邮箱）
# 参考实现：E:\bs\code\ubs.ai\atlassian-mcp\AtlassianQueryService.cs ViewImageAsync
VISION_HTTP_DOWNLOAD_TOKEN=
VISION_HTTP_DOWNLOAD_TOKEN_TYPE=bearer   # bearer | basic | header
# Atlassian 附件下载的 Basic 认证用户（即你的 Atlassian 登录邮箱）。
# 配置后，页面 URL、/wiki/download/attachments 等附件 URL 会自动走 REST API + Basic 认证下载。
VISION_ATLASSIAN_USER=
# 额外的自定义下载请求头（JSON 字符串）。Atlassian 图片常需：
#   {"X-Atlassian-Token":"no-check"}
VISION_HTTP_DOWNLOAD_HEADERS=

# ---------------------------------------------------------------------------
# MCP Server 通用配置
# ---------------------------------------------------------------------------
MCP_TRANSPORT=stdio               # stdio | http
MCP_HOST=127.0.0.1                # HTTP 监听地址
MCP_PORT=8081                     # HTTP 监听端口
MCP_AUTH_MODE=none                # none | token
MCP_SERVER_TOKEN=                 # 当 MCP_AUTH_MODE=token 时的认证 Token
MCP_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
# 客户端连接时的重定向地址 `Mcp-Session-Id` 等透传无需配置。
# 若需自定义会话相关能力，可参照 server.py 中的配置注释。
